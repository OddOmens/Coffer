# --- Storage -------------------------------------------------------------
# The folder that holds your files (on the host). Coffer and Samba both use it.
COFFER_FILES_DIR=/srv/coffer/files
# Coffer's database, secret key, thumbnails and logo. Back this up.
COFFER_DATA_DIR=/srv/coffer/data
# Owner of COFFER_FILES_DIR on the host (run `id` to find yours).
PUID=1000
PGID=1000

# --- Version -------------------------------------------------------------
# Image tag to run: "latest", a version like 0.3.0, or 0.3 for 0.3.x fixes.
# Pin a version if you want to choose when to update.
COFFER_VERSION=latest

# --- First start ---------------------------------------------------------
# Creates this admin on first start. Leave the password empty to have a random
# one printed in `docker compose logs coffer`.
COFFER_ADMIN_USER=admin
COFFER_ADMIN_PASSWORD=

# --- Public share links ----------------------------------------------------
# The public address share links are built with, e.g. https://files.example.com
COFFER_PUBLIC_URL=
# Reverse proxies allowed to report the real client IP and https on 8081, as
# exact addresses, not ranges. The bundled tunnel is already trusted. For a
# proxy on the host, use the gateway of Coffer's network
# (`docker network inspect coffer_default`).
COFFER_TRUSTED_PROXIES=
# The same for a reverse proxy in front of the full app on 8080.
COFFER_APP_TRUSTED_PROXIES=
# Optional: only these networks may sign in on port 8080 (others only see share
# links). e.g. 192.168.1.0/24,100.64.0.0/10 for LAN + Tailscale.
COFFER_APP_NETWORKS=

# Which host addresses and ports to publish on.
COFFER_APP_BIND=0.0.0.0
COFFER_APP_PORT=8080
COFFER_PUBLIC_BIND=127.0.0.1
COFFER_PUBLIC_PORT=8081

# --- Samba (After Effects / Finder) ---------------------------------------
SMB_SHARE_NAME=Files
# if_required = no encryption (fastest on a trusted LAN); required = always encrypt.
SMB_ENCRYPT=if_required
SMB_BIND=0.0.0.0
# Use another port if the host already runs Samba (connect with smb://host:4450).
SMB_PORT=445
# Addresses allowed to connect (space-separated). Default: private, VPN
# (Tailscale 100.64/10), link-local and loopback ranges.
SMB_HOSTS_ALLOW=
# Without Samba: docker compose up -d coffer

# --- Monitoring & updates -------------------------------------------------
# Set a long random token to enable Prometheus metrics at /metrics
# (send it as "Authorization: Bearer <token>").
COFFER_METRICS_TOKEN=
# Daily check for new releases on GitHub (no personal data is sent).
COFFER_UPDATE_CHECK=true

# --- Media previews (the "media" service) ---------------------------------
# CPU cores and ffmpeg threads for making video previews.
COFFER_MEDIA_CPUS=4
COFFER_MEDIA_THREADS=

# --- Cloudflare Tunnel (docker compose --profile tunnel up -d) ------------
# Token of a tunnel whose public hostname points at http://coffer:8081.
# Then set COFFER_PUBLIC_URL to https://<that hostname>. The tunnel runs at a
# fixed address that Coffer already trusts; no COFFER_TRUSTED_PROXIES needed.
CLOUDFLARE_TUNNEL_TOKEN=
